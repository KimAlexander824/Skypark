# Скопируйте в .env и поменяйте значения. Файл .env в git не коммитим.

POSTGRES_USER=skypark
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skypark

# Для запуска без Docker. В docker-compose переопределяется.
DATABASE_URL=postgresql+psycopg://skypark:change-me@localhost:5432/skypark

# insightface — настоящая модель; fake — заглушка без нейросети (для разработки фронта)
FACE_ENGINE=insightface
FACE_MODEL=buffalo_l
# Порог «это тот же ребёнок». Подобрать на реальных фото: python -m scripts.evaluate_threshold
MATCH_THRESHOLD=0.5
AMBIGUITY_MARGIN=0.05
MAX_FACE_PROFILES_PER_CHILD=5
