# Настройки docker-compose. Скопируйте в .env (Windows: copy .env.example .env).
# Файл .env в git не коммитим.

POSTGRES_USER=skypark
POSTGRES_PASSWORD=change-me

# Распознавание: insightface — настоящая нейросеть; fake — заглушка (лицо = цвет картинки)
FACE_ENGINE=insightface
# Порог «это тот же ребёнок». Подобрать на реальных фото (README сервиса распознавания)
MATCH_THRESHOLD=0.5
# Регистрация: лица на заднем плане меньше этой доли главного игнорируются (0 — строго одно лицо)
MULTIPLE_FACES_MIN_RATIO=0.25
# Токен для HTTP API распознавания (заголовок X-Internal-Token). Пусто — без проверки.
INTERNAL_TOKEN=
