# Настройки docker-compose. Скопируйте в .env (Windows: copy .env.example .env).
# Файл .env в git не коммитим.

# dev — разработка; prod — сервер (вместе с docker-compose.prod.yml)
APP_ENV=dev

POSTGRES_USER=skypark
# На сервере — длинный случайный пароль:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# С паролем-примером сервис в APP_ENV=prod не запустится.
POSTGRES_PASSWORD=change-me
# Пароль Redis — нужен только на сервере (docker-compose.prod.yml)
REDIS_PASSWORD=

# Распознавание: insightface — настоящая нейросеть; fake — заглушка (лицо = цвет картинки)
FACE_ENGINE=insightface
# Порог «это тот же ребёнок». Подобрать на реальных фото (README сервиса распознавания)
MATCH_THRESHOLD=0.5
# Регистрация: лица на заднем плане меньше этой доли главного игнорируются (0 — строго одно лицо)
MULTIPLE_FACES_MIN_RATIO=0.25
# Токен для HTTP API распознавания (заголовок X-Internal-Token).
# Разработка: можно пусто (без проверки). Сервер: обязателен, 32+ символа.
INTERNAL_TOKEN=
