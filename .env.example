# Скопируйте в .env и поменяйте значения. Файл .env в git не коммитим.

POSTGRES_USER=skypark
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skypark

# Для запуска без Docker. В docker-compose переопределяется.
DATABASE_URL=postgresql+psycopg://skypark:change-me@localhost:5432/skypark

# Длинная случайная строка: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Общий секрет с Telegram-ботом (заголовок X-Bot-Token). Пусто — API бота выключено.
BOT_API_TOKEN=change-me-bot-token

PUBLIC_BASE_URL=http://localhost:8000
PARK_TIMEZONE=Asia/Tashkent

# insightface — настоящая модель; fake — заглушка без нейросети (для разработки)
FACE_ENGINE=insightface
FACE_MODEL=buffalo_l
MATCH_THRESHOLD=0.5

PAYMENT_PROVIDER=fake
REMINDER_MINUTES_BEFORE_END=15
EXTENSION_PAYMENT_GRACE_MINUTES=10
