# Для запуска сервиса БЕЗ docker-compose (uvicorn / python -m app.worker на своём компьютере).
# В docker-compose эти значения задаются в docker-compose.yml.

APP_ENV=dev

SHARD_DATABASE_URLS=postgresql+psycopg://skypark:change-me@localhost:5432/recognition_1,postgresql+psycopg://skypark:change-me@localhost:5432/recognition_2,postgresql+psycopg://skypark:change-me@localhost:5432/recognition_3
REDIS_URL=redis://localhost:6379
QUEUE_NAME=recognition

# insightface — настоящая модель; fake — заглушка без нейросети (для разработки)
FACE_ENGINE=insightface
MATCH_THRESHOLD=0.5
AMBIGUITY_MARGIN=0.05
HNSW_EF_SEARCH=200
MAX_FACE_PROFILES_PER_CHILD=5
MULTIPLE_FACES_MIN_RATIO=0.25
WORKER_CONCURRENCY=1
INTERNAL_TOKEN=
# Папка с весами модели (в Docker уже задано: /opt/models)
FACE_MODEL_ROOT=~/.insightface
# Лимиты на входное фото
MAX_PHOTO_BYTES=10485760
MAX_IMAGE_PIXELS=50000000
