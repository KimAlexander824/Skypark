# Скопируйте в .env.local (он не попадает в git) и поменяйте нужное.

# Распознавание лиц: mock — демо-ответы без сервиса; service — настоящий сервис распознавания
VITE_FACE_API=mock

# Адрес сервиса распознавания (docker compose в корне репозитория: http://localhost:8001)
RECOGNITION_URL=http://localhost:8001
# Если в backend/.env задан INTERNAL_TOKEN — тот же токен сюда (браузеру он не передаётся)
RECOGNITION_TOKEN=
